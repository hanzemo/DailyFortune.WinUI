<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DailyFortune.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:DailyFortune.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
