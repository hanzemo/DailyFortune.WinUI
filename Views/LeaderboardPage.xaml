<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DailyFortune.WinUI.Views.LeaderboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:DailyFortune.WinUI.Models"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="排行榜" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <RadioButton Content="今日" GroupName="Period" Tag="0" Checked="Period_Checked"/>
            <RadioButton Content="本周" GroupName="Period" Tag="1" Checked="Period_Checked"/>
            <RadioButton Content="本月" GroupName="Period" Tag="2" Checked="Period_Checked"/>
            <RadioButton Content="本年" GroupName="Period" Tag="3" Checked="Period_Checked"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LeaderboardGroup">
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock Text="{x:Bind Fortune}" FontSize="22" FontWeight="Bold"
                                       Foreground="{x:Bind Fortune, Converter={StaticResource StringToBrushConverter}}"/>
                            <ItemsControl ItemsSource="{x:Bind Users}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LeaderboardUser">
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind DisplayName}"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Username}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="48" Height="48"/>
    </Grid>
</Page>
