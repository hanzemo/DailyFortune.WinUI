<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DailyFortune.WinUI.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DailyFortune.WinUI.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">

            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                          Width="48" Height="48"/>

            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"/>

            <StackPanel x:Name="ProfileRoot" Spacing="16"
                        Visibility="{x:Bind ViewModel.HasProfile, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">

                <Grid Height="180">
                    <Border CornerRadius="12"
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"/>
                    <Image Source="{x:Bind ViewModel.BackgroundImage, Mode=OneWay}"
                           Stretch="UniformToFill"/>
                    <StackPanel Orientation="Horizontal" Spacing="16"
                                VerticalAlignment="Bottom" Padding="16">
                        <PersonPicture Width="88" Height="88"
                                       ProfilePicture="{x:Bind ViewModel.AvatarImage, Mode=OneWay}"/>
                        <StackPanel VerticalAlignment="Bottom" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                                       FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind ViewModel.UsernameDisplay, Mode=OneWay}"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.Bio, Mode=OneWay}" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.HasDrawnToday, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="今日运势："/>
                    <TextBlock Text="{x:Bind ViewModel.TodaysFortune, Mode=OneWay}"
                               FontWeight="Bold"
                               Foreground="{x:Bind ViewModel.FortuneBrush, Mode=OneWay}"/>
                </StackPanel>

                <Grid ColumnSpacing="12" Padding="12"
                      Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                      CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TotalDraws, Mode=OneWay}"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="总抽签" HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{x:Bind ViewModel.Streak, Mode=OneWay}"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="连续天数" HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{x:Bind ViewModel.RegistrationDate, Mode=OneWay}"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="加入" HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{x:Bind ViewModel.LastActiveDate, Mode=OneWay}"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="最近活跃" HorizontalAlignment="Center" Opacity="0.7"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="运势历史（近一年）" FontSize="20" FontWeight="Bold"/>
                <local:FortuneHeatmapControl History="{x:Bind ViewModel.HistoryItems, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
