<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DailyFortune.WinUI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootGrid">
        <Border x:Name="FortuneBackground" Visibility="Collapsed"/>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}"/>

            <Grid Grid.Row="1" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                    <TextBlock x:Name="FortuneLabel"
                               Text="你的今日运势是"
                               FontSize="20" HorizontalAlignment="Center"
                               Foreground="White"
                               Visibility="{x:Bind ViewModel.HasFortune, Mode=OneWay}"/>

                    <TextBlock x:Name="FortuneText"
                               Text="{x:Bind ViewModel.Fortune, Mode=OneWay}"
                               FontSize="96" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               Visibility="{x:Bind ViewModel.HasFortune, Mode=OneWay}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasCountdown, Mode=OneWay}">
                        <TextBlock Text="距离下次抽取："
                                   FontSize="18" Foreground="White"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CountdownText"
                                   Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="DrawButton"
                            Content="抽取运势"
                            FontSize="20" Padding="40,20"
                            HorizontalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.DrawCommand}"
                            Visibility="{x:Bind ViewModel.CanDraw, Mode=OneWay}"/>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="32" Height="32"
                                  Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Foreground="White"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
