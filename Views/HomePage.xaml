<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DailyFortune.WinUI.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="主页" Style="{StaticResource TitleTextBlockStyle}" Margin="24,24,24,0"/>

        <Grid Grid.Row="1" Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <TextBlock x:Name="FortuneLabel" Text="你的今日运势是"
                           FontSize="20" HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasFortune, Mode=OneWay}"/>
                <TextBlock x:Name="FortuneText" Text="{x:Bind ViewModel.Fortune, Mode=OneWay}"
                           FontSize="80" FontWeight="Bold" HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasFortune, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                           FontSize="18" HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.HasCountdown, Mode=OneWay}"/>
                <Button x:Name="DrawButton"
                        Content="抽取运势"
                        FontSize="20" Padding="40,20"
                        HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.DrawCommand}"
                        Visibility="{x:Bind ViewModel.CanDraw, Mode=OneWay}"/>
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32" Height="32"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
