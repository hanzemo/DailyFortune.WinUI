<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="DailyFortune.WinUI.Views.Admin.AdminEditUserDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="编辑用户"
               PrimaryButtonText="保存"
               CloseButtonText="取消"
               PrimaryButtonClick="OnSave">
    <StackPanel Spacing="12" MinWidth="360">
        <TextBox Header="显示名" x:Name="DisplayNameBox"/>
        <TextBox Header="简介" x:Name="BioBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        <TextBox Header="头像 URL" x:Name="AvatarBox"/>
        <TextBox Header="QQ" x:Name="QqBox" InputScope="Number"/>
    </StackPanel>
</ContentDialog>
