<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DailyFortune.WinUI.Views.Admin.AdminUserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:DailyFortune.WinUI.Models"
      xmlns:conv="using:DailyFortune.WinUI.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="用户管理" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Grid.Column="1" Content="刷新"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.LoadCommand}"/>
        </Grid>

        <TextBox Grid.Row="1" PlaceholderText="搜索用户名/昵称/邮箱"
                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Users}"
                  IsItemClickEnabled="True" ItemClick="User_Click">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:UserMeProfile">
                    <Grid Padding="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PersonPicture Width="48" Height="48"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                <Border Padding="6,2" CornerRadius="4"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{x:Bind IsAdmin}">
                                    <TextBlock Text="管理员" FontSize="11"/>
                                </Border>
                            </StackPanel>
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="@"/><Run Text="{x:Bind Username}"/>
                                <Run Text=" · "/><Run Text="{x:Bind Email}"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock FontSize="11">
                                    <Run Text="抽签 "/><Run Text="{x:Bind TotalDraws}"/>
                                </TextBlock>
                                <TextBlock Text="已隐藏" FontSize="11" Foreground="Orange"
                                           Visibility="{x:Bind IsHidden}"/>
                                <TextBlock Text="{x:Bind TagsText}" FontSize="11" Foreground="DodgerBlue"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Text="{x:Bind Status}"
                                   Foreground="{x:Bind Status, Converter={StaticResource StatusToBrush}}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="48" Height="48"/>
    </Grid>
</Page>
